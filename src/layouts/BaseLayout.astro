---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { business, navLinks, faqs } from '../data/business';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; breadcrumbs?: { name: string; path: string }[]; }
const { title, description, canonicalPath = '/', image, breadcrumbs = [] } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://yossy-travel-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const path = Astro.url.pathname;
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
const showFaq = path === '/kontak' || path === '/kontak/';
const faqJsonLd = showFaq ? faqs : [];
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} breadcrumbs={breadcrumbs} faqJsonLd={faqJsonLd} />
</head>
<body class="bg-[#f4f6fb] text-zinc-900 antialiased">
  <header>
    <div class="bg-blue-900 text-blue-50 text-xs">
      <p class="max-w-7xl mx-auto px-4 py-2 tracking-wide">Executive class via tol Sumatera — loket Simpang Kawat Jambi, {business.phoneDisplay}</p>
    </div>
    <div class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-blue-900/10">
      <nav class="max-w-7xl mx-auto flex items-center justify-between px-4 py-3" aria-label="Navigasi utama">
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid place-items-center w-9 h-9 rounded-xl bg-blue-900 text-white font-bold text-sm">YM</span>
          <span class="font-bold tracking-tight text-sm leading-tight">Yossy Mandiri<br /><span class="font-normal text-zinc-500 text-xs">Executive Tol Sumatera</span></span>
        </a>
        <div class="hidden md:flex gap-6 text-sm text-zinc-600">
          {navLinks.map((n) => (
            <a href={n.href} class:list={['transition hover:text-blue-900 hover:-translate-y-px', active(n.href) && 'text-blue-900 font-semibold underline underline-offset-8 decoration-blue-900 decoration-2']}>{n.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-2">
          <a href={business.ctaUrl} target="_blank" rel="noopener" class="hidden sm:inline-block bg-blue-900 text-white px-5 py-2.5 rounded-full text-sm font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">{business.ctaLabel}</a>
          <button id="menu-btn" type="button" class="md:hidden grid place-items-center w-12 h-12 rounded-full border border-blue-900/20 text-blue-900" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu navigasi">
            <svg id="menu-ic-open" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg id="menu-ic-close" aria-hidden="true" focusable="false" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden border-t border-blue-900/10 bg-white">
        <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1 text-base" aria-label="Navigasi seluler">
          {navLinks.map((n) => (
            <a href={n.href} class:list={['min-h-[48px] flex items-center px-3 rounded-2xl transition hover:bg-blue-900/5', active(n.href) && 'text-blue-900 font-semibold bg-blue-900/5']}>{n.label}</a>
          ))}
          <a href={business.ctaUrl} target="_blank" rel="noopener" class="mt-2 text-center bg-blue-900 text-white px-6 py-3 rounded-full text-sm font-semibold min-h-[48px] grid place-items-center">{business.ctaLabel}</a>
        </nav>
      </div>
    </div><!-- /sticky bar -->
  </header>
  <main><slot /></main>
  <footer class="mt-20 border-t-2 border-blue-900/15 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-12 grid gap-8 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-bold tracking-tight text-lg">PT Yossy Mandiri Travel <span class="font-normal text-blue-900 text-sm">— executive via tol</span></p>
        <p class="mt-2 text-base text-zinc-600 leading-relaxed max-w-[65ch]">{business.address}</p>
        <p class="mt-1 text-sm text-zinc-500">{business.hours}</p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {navLinks.map((n) => (
            <a href={n.href} class="underline underline-offset-4 decoration-blue-900/40">{n.label}</a>
          ))}
        </div>
      </div>
      <div class="md:col-span-5">
        <p class="font-semibold text-sm">Hubungi loket</p>
        <div class="mt-3 flex flex-col gap-2 text-sm">
          <a href={business.ctaUrl} target="_blank" rel="noopener" class="underline underline-offset-4">{business.ctaLabel} — {business.phoneDisplay}</a>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="underline underline-offset-4">Google Maps — rute ke lokasi</a>
          <a href={business.tarifUrl} target="_blank" rel="noopener" class="underline underline-offset-4">Tarif resmi — yossymandiritravel.com</a>
        </div>
        <p class="mt-6 text-xs text-zinc-600">© 2026 {business.name} — {business.city}.</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      const icOpen = document.getElementById('menu-ic-open');
      const icClose = document.getElementById('menu-ic-close');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
        icOpen?.classList.toggle('hidden', open);
        icClose?.classList.toggle('hidden', !open);
      });
    });
  </script>
</body>
</html>
