---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, routes, fleet } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo, saya mau pesan kursi travel.')}`;
---
<BaseLayout title={business.title} description={business.description} canonicalPath={business.canonicalPath} image={business.ogImage}>
  <!-- HERO SPLIT: kiri teks, kanan peta rute SVG line-drawing -->
  <section class="max-w-6xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center py-10 md:py-14">
      <div class="md:col-span-6 reveal">
        <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-wide uppercase text-blue-900 bg-blue-900/5 border border-blue-900/15 rounded-full px-4 py-1.5">
          Executive tol Sumatera <span class="font-mono-num">{business.rating} / 5</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tight leading-[1.02] font-bold">Jambi–Palembang–Jakarta via tol, duduk captain seat</h1>
        <p class="mt-5 text-base text-zinc-600 leading-relaxed max-w-[60ch]">Loket Simpang Kawat Jambi. Hiace Premio, Innova Reborn, dan Fortuner executive class via tol — antar-jemput hingga lokasi. Lampung–Jambi dan Palembang–Jambi Rp430rb.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={cta} target="_blank" rel="noopener" class="bg-blue-900 text-white px-7 py-3.5 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan Kursi via WA</a>
          <a href="/jadwal" class="border border-blue-900/30 text-blue-900 px-7 py-3.5 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Lihat Jadwal Tol</a>
        </div>
        <dl class="mt-8 flex gap-8 border-t-2 border-blue-900/15 pt-5 text-sm max-w-[60ch]">
          <div><dt class="sr-only">Rute</dt><dd class="font-mono-num font-semibold text-lg">{routes.length}</dd><dd class="text-zinc-500">Rute aktif</dd></div>
          <div><dt class="sr-only">Armada</dt><dd class="font-mono-num font-semibold text-lg">8</dd><dd class="text-zinc-500">Foto armada</dd></div>
          <div><dt class="sr-only">Tarif</dt><dd class="font-mono-num font-semibold text-lg">430rb</dd><dd class="text-zinc-500">Terverifikasi</dd></div>
        </dl>
      </div>
      <div class="md:col-span-6 reveal reveal-d1">
        <div class="bg-white border border-blue-900/15 rounded-[2rem] p-6 md:p-8" role="img" aria-label="Peta rute executive via tol: Jambi, Palembang, Pekanbaru, Padang, Jakarta">
          <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Peta rute via tol</p>
          <svg viewBox="0 0 400 300" class="mt-3 w-full h-auto" fill="none" aria-hidden="true">
            <path d="M40 40 H360 M40 40 V260 M40 260 H360 M360 40 V260" stroke="#dbe3f5" stroke-width="1.5" stroke-dasharray="5 6" />
            <path class="route-draw" d="M200 250 C 190 210, 150 200, 140 160 C 130 115, 170 100, 175 70" stroke="#1e3a8a" stroke-width="3" stroke-linecap="round" />
            <path class="route-draw-2" d="M200 250 C 230 220, 260 215, 280 180 C 300 145, 290 110, 310 80" stroke="#1e3a8a" stroke-width="2" stroke-dasharray="1 0" opacity="0.55" />
            <circle class="route-pulse" cx="200" cy="250" r="7" fill="#1e3a8a" opacity="0.35" />
            <g font-family="monospace" font-size="11" fill="#1e3a8a" font-weight="600">
              <circle class="route-dot" cx="200" cy="250" r="5" fill="#1e3a8a" /><text x="212" y="254">Jambi</text>
              <circle class="route-dot" cx="140" cy="160" r="5" fill="#1e3a8a" /><text x="90" y="150">Palembang</text>
              <circle class="route-dot" cx="280" cy="180" r="5" fill="#1e3a8a" /><text x="292" y="184">Pekanbaru</text>
              <circle class="route-dot" cx="175" cy="70" r="5" fill="#1e3a8a" /><text x="187" y="74">Jakarta</text>
              <circle class="route-dot" cx="310" cy="80" r="5" fill="#1e3a8a" /><text x="300" y="64">Padang</text>
            </g>
          </svg>
          <p class="mt-2 text-xs text-zinc-500">Garis navy: koridor tol Jambi–Palembang–Jakarta. Garis tipis: Jambi–Pekanbaru–Padang.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STRIP RUTE (bukan kartu 3-col): daftar horizontal -->
  <section class="max-w-6xl mx-auto px-4 py-8 w-full">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl md:text-3xl tracking-tight font-bold">Koridor yang lewat tol</h2>
      <a href="/jadwal" class="text-sm font-medium text-blue-900 underline underline-offset-4 shrink-0">Semua tarif</a>
    </div>
    <ol class="mt-5 divide-y divide-blue-900/10 border-y-2 border-blue-900/15">
      {routes.slice(0, 5).map((r, i) => (
        <li class="reveal flex items-center gap-4 py-3.5">
          <span class="font-mono-num text-xs text-blue-900 font-semibold w-8">0{i + 1}</span>
          <p class="font-semibold flex-1">{r.name}</p>
          <p class="font-mono-num text-sm font-semibold text-blue-900">{r.price}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- COVERFLOW TEASER -->
  <section class="py-10 w-full">
    <div class="max-w-6xl mx-auto px-4 flex items-end justify-between gap-4">
      <h2 class="text-2xl md:text-3xl tracking-tight font-bold">Lihat kabinnya dulu</h2>
      <a href="/armada" class="text-sm font-medium text-blue-900 underline underline-offset-4 shrink-0">Buka galeri 8 armada</a>
    </div>
    <div class="coverflow mt-6 flex gap-5 overflow-x-auto px-[8vw] pb-2">
      {fleet.slice(0, 6).map((v) => (
        <figure class="shrink-0 w-64 md:w-80">
          <img src={`/images/${v.img}`} alt={v.name} width={v.w} height={v.h} loading="lazy" class="w-full h-64 object-cover rounded-[1.75rem] border border-blue-900/15" />
          <figcaption class="mt-2 text-sm font-semibold">{v.name}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <h2 class="text-2xl md:text-3xl tracking-tight font-bold">Rating <span class="font-mono-num">{business.rating}</span> — {business.name}</h2>
        <p class="mt-3 text-base text-zinc-600">{business.address}. <a class="underline underline-offset-4 text-blue-900" href={business.mapsUrl} target="_blank" rel="noopener">Lihat di Google Maps</a></p>
      </div>
      <div class="md:col-span-5">
        <div class="rounded-[2rem] overflow-hidden border border-blue-900/15 aspect-video bg-zinc-100">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-14 w-full">
    <div class="bg-blue-900 text-white rounded-[2rem] p-8 md:p-12 md:grid md:grid-cols-12 md:gap-8 md:items-center">
      <div class="md:col-span-8">
        <h2 class="text-2xl md:text-3xl tracking-tight font-bold">Kursi Premio habis tiap akhir pekan</h2>
        <p class="mt-2 text-sm text-blue-100">Kirim rute + tanggal via WA, admin kunci kursi sebelum transfer.</p>
      </div>
      <div class="md:col-span-4 mt-6 md:mt-0 md:text-right">
        <a href={cta} target="_blank" rel="noopener" class="inline-block bg-white text-blue-900 px-8 py-3.5 rounded-full font-semibold transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan Kursi via WA</a>
      </div>
    </div>
  </section>
</BaseLayout>
