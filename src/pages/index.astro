---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteCard from '../components/RouteCard.astro';
import FleetCard from '../components/FleetCard.astro';
import StepsPesan from '../components/StepsPesan.astro';
import TrustBadges from '../components/TrustBadges.astro';
import Faq from '../components/Faq.astro';
import { business, routes, fleet, faqs } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo, saya mau pesan kursi travel.')}`;
const jamFor = (r: { status: string }) => (r.status.includes('Terverifikasi') ? 'Konfirmasi jam via WA' : 'Tanya jadwal via WA');
const waFor = (name: string) => `https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo, saya mau pesan kursi ${name}. Apakah tersedia?`)}`;
const extraFaqs = [
  { q: 'Berapa bagasi yang boleh dibawa?', a: 'Ketentuan bagasi tidak dipublikasikan di situs resmi — tanyakan batas koper dan tarif over-bagasi via WA sebelum berangkat.' },
  { q: 'Bagaimana refund jika batal berangkat?', a: 'Ketentuan refund tidak dipublikasikan — minta kebijakan pembatalan tertulis via WA sebelum membayar.' },
  { q: 'Di mana titik jemput di Jambi?', a: 'Loket Simpang Kawat Jl. HOS. Cokroaminoto, plus antar-jemput hingga lokasi tujuan. Konfirmasi titik jemput saat booking.' },
  { q: 'Apakah berangkat jika penumpang sedikit?', a: 'Jadwal keberangkatan harian mengikuti kuota kursi — konfirmasi H-1 via WA apakah kursi penuh atau dialihkan ke unit berikutnya.' },
];
---
<BaseLayout title={business.title} description={business.description} canonicalPath={business.canonicalPath} image={business.ogImage}>
  <!-- Ref: Awwwards atlas travel map — dotted route line, mono waypoints, postage-stamp frame, ticket stub -->
  <section class="relative overflow-hidden w-full">
    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="route-draw-hero opacity-25" d="M -40 420 C 120 360, 220 300, 320 260 S 520 180, 620 200 S 820 260, 920 180 S 1100 100, 1240 60" stroke="#1e3a8a" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 12" fill="none" />
      <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="#1e3a8a" font-weight="600">
        <circle cx="320" cy="260" r="4" fill="#1e3a8a" />
        <text x="332" y="256">JMB 01°38'S</text>
        <circle cx="620" cy="200" r="4" fill="#1e3a8a" />
        <text x="632" y="196">PLG 02°59'S</text>
        <circle cx="920" cy="180" r="4" fill="#1e3a8a" />
        <text x="932" y="176">JKT 06°12'S</text>
      </g>
    </svg>
    <div class="max-w-7xl mx-auto px-4 py-12 md:py-20 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 reveal">
          <p class="inline-flex items-center gap-2 font-mono-num text-[11px] tracking-[0.2em] uppercase text-blue-900 border border-dashed border-blue-900/40 rounded-full px-4 py-1.5">
            Atlas · Rute tol Sumatera · 01°38'S 103°37'E
          </p>
          <h1 class="mt-6 text-4xl md:text-6xl tracking-tight leading-[1.02] font-bold max-w-[18ch]">Jambi–Palembang–Jakarta via tol, duduk captain seat</h1>
          <p class="mt-5 text-base text-zinc-600 leading-relaxed max-w-[60ch]">Loket Simpang Kawat Jambi. Hiace Premio, Innova Reborn, dan Fortuner executive class via tol — antar-jemput hingga lokasi. Lampung–Jambi dan Palembang–Jambi Rp430rb.</p>
          <p class="mt-3 font-mono-num text-sm font-semibold text-blue-900">Jam: konfirmasi via WA — loket buka setiap hari</p>

          <div class="mt-8 max-w-[60ch] border-2 border-dashed border-blue-900/30 bg-white/70 p-5 relative">
            <div class="flex items-center justify-between font-mono-num text-[11px] uppercase tracking-[0.18em] text-blue-900">
              <span>Boarding pass</span>
              <span>YM-042 · TOL</span>
            </div>
            <div class="my-3 border-t-2 border-dashed border-blue-900/20"></div>
            <dl class="grid grid-cols-3 gap-4 text-sm">
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wide">Rute aktif</dt>
                <dd class="font-mono-num font-semibold text-lg text-blue-900">{routes.length}</dd>
              </div>
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wide">Foto armada</dt>
                <dd class="font-mono-num font-semibold text-lg text-blue-900">8</dd>
              </div>
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wide">Terverifikasi</dt>
                <dd class="font-mono-num font-semibold text-lg text-blue-900">430rb</dd>
              </div>
            </dl>
            <div class="mt-3 pt-3 border-t-2 border-dashed border-blue-900/20 flex items-center justify-between text-xs text-zinc-500">
              <span class="font-mono-num">JMB → PLG → JKT</span>
              <span>Executive class via tol</span>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={cta} target="_blank" rel="noopener" class="bg-blue-900 text-white px-7 py-3.5 rounded-full font-medium min-h-[48px] inline-flex items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan Kursi via WA</a>
            <a href="/jadwal" class="border border-blue-900/30 text-blue-900 px-7 py-3.5 rounded-full font-medium min-h-[48px] inline-flex items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Lihat Jadwal Tol</a>
          </div>
        </div>

        <div class="lg:col-span-5 lg:mt-16 reveal reveal-d1">
          <div class="relative rotate-[-2deg] translate-x-2">
            <div class="border-2 border-dashed border-blue-900/50 bg-white p-2 shadow-lg shadow-blue-900/10">
              <img src="/images/yossy-stamp.webp" alt="Armada PT Yossy Mandiri Travel — executive via tol" width="648" height="864" loading="lazy" decoding="async" fetchpriority="low" class="w-full aspect-[4/5] object-cover" />
            </div>
            <p class="mt-3 font-mono-num text-xs text-blue-900 tracking-wide">STAMP · JMB 01°38'S 103°37'E</p>
          </div>

          <div class="mt-8 border-2 border-dashed border-blue-900/20 bg-white/60 p-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Peta rute via tol</p>
            <svg viewBox="0 0 400 220" class="mt-2 w-full h-auto" fill="none" aria-hidden="true">
              <path d="M20 20 H380 M20 20 V200 M20 200 H380 M380 20 V200" stroke="#dbe3f5" stroke-width="1" stroke-dasharray="4 6" />
              <path class="route-draw" d="M200 190 C 190 155, 150 145, 140 110 C 130 75, 170 65, 175 40" stroke="#1e3a8a" stroke-width="2.5" stroke-linecap="round" />
              <path class="route-draw-2" d="M200 190 C 230 165, 260 160, 280 130 C 300 100, 290 75, 310 50" stroke="#1e3a8a" stroke-width="1.5" stroke-dasharray="1 0" opacity="0.55" />
              <g font-family="monospace" font-size="10" fill="#1e3a8a" font-weight="600">
                <circle cx="200" cy="190" r="4" fill="#1e3a8a" /><text x="210" y="194">Jambi</text>
                <circle cx="140" cy="110" r="4" fill="#1e3a8a" /><text x="88" y="102">Palembang</text>
                <circle cx="280" cy="130" r="4" fill="#1e3a8a" /><text x="292" y="134">Pekanbaru</text>
                <circle cx="175" cy="40" r="4" fill="#1e3a8a" /><text x="187" y="44">Jakarta</text>
                <circle cx="310" cy="50" r="4" fill="#1e3a8a" /><text x="298" y="36">Padang</text>
              </g>
            </svg>
            <p class="mt-2 text-xs text-zinc-500">Garis navy: koridor tol Jambi–Palembang–Jakarta. Garis tipis: Jambi–Pekanbaru–Padang.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ref: Shakuro Umrah&Hajj tour — 02 Rute populer: tabel desktop / cards mobile -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">02 — Rute populer</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-bold">Koridor yang lewat tol</h2>
      </div>
      <a href="/jadwal" class="text-sm font-medium text-blue-900 underline underline-offset-4 shrink-0">Semua tarif</a>
    </div>
    <div class="mt-6 hidden md:block bg-white border border-blue-900/15 rounded-[2rem] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-blue-900 text-white">
          <tr class="text-left"><th scope="col" class="py-3.5 px-5 font-semibold">Rute</th><th scope="col" class="py-3.5 px-5 font-semibold">Jam</th><th scope="col" class="py-3.5 px-5 font-semibold">Harga</th><th scope="col" class="py-3.5 px-5 font-semibold">Status</th><th scope="col" class="py-3.5 px-5 font-semibold"><span class="sr-only">Aksi</span></th></tr>
        </thead>
        <tbody class="divide-y divide-blue-900/10">
          {routes.slice(0, 5).map((r, i) => (
            <tr class:list={['transition hover:bg-blue-900/5', i % 2 === 1 && 'bg-slate-100/80']}>
              <td class="py-4 px-5 font-semibold">{r.name}</td>
              <td class="py-4 px-5 font-mono-num text-sm whitespace-nowrap">{jamFor(r)}</td>
              <td class="py-4 px-5 font-mono-num font-semibold whitespace-nowrap text-blue-900">{r.price}</td>
              <td class="py-4 px-5"><span class={`text-xs font-medium px-3 py-1.5 rounded-full whitespace-nowrap ${r.status.includes('Terverifikasi') ? 'bg-blue-900 text-white' : 'bg-amber-100 text-amber-800'}`}>{r.status}</span></td>
              <td class="py-4 px-5 text-right"><a href={waFor(r.name)} target="_blank" rel="noopener" class="inline-block bg-blue-900 text-white px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap">Pesan</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-4 md:hidden">
      {routes.slice(0, 5).map((r, i) => (<RouteCard r={r} jam={jamFor(r)} wa={waFor(r.name)} index={i} />))}
    </div>
  </section>

  <!-- Ref: Awwwards Fulidhoo Tours travel UI — 03 Armada foto + seat/AC/plus -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">03 — Armada</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-bold">Lihat kabinnya dulu</h2>
      </div>
      <a href="/armada" class="text-sm font-medium text-blue-900 underline underline-offset-4 shrink-0">Galeri 8 armada</a>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {fleet.slice(0, 3).map((v, i) => (<FleetCard v={v} index={i} />))}
    </div>
  </section>

  <!-- Ref: FlowLab booking — 04 Cara pesan 4 langkah + form ringkas -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">04 — Cara pesan</p>
    <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-bold">Pilih → Isi form → WA → Tiba H−30 menit</h2>
    <div class="mt-6"><StepsPesan /></div>
    <div class="mt-6 text-center">
      <a href="/pesan" class="inline-flex items-center bg-blue-900 text-white px-8 py-3.5 rounded-full font-medium min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Isi form pesan kursi</a>
    </div>
  </section>

  <!-- Ref: Haramain agency — 05 FAQ + Kontak loket -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">05 — FAQ</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-bold">Sering ditanyakan</h2>
        <div class="mt-4 bg-white border border-blue-900/15 rounded-[2rem] px-6 md:px-8">
          <Faq items={[...faqs, ...extraFaqs]} />
        </div>
      </div>
      <div class="md:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Kontak loket</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-bold">Telepon loket, bukan calo</h2>
        <div class="mt-4 bg-blue-900 text-white rounded-[2rem] p-8">
          <p class="text-sm text-blue-100">{business.address}</p>
          <p class="mt-2 text-sm text-blue-100">{business.hours}</p>
          <p class="mt-4 font-mono-num font-semibold text-lg">{business.phoneDisplay}</p>
          {business.phoneAlt && <p class="mt-1 text-xs text-blue-200">{business.phoneAlt}</p>}
          <div class="mt-6 flex flex-col gap-3">
            <a href={cta} target="_blank" rel="noopener" class="bg-white text-blue-900 text-center px-6 py-3 rounded-full text-sm font-semibold min-h-[48px] grid place-items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">{business.ctaLabel}</a>
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="border border-white/40 text-center px-6 py-3 rounded-full text-sm font-medium min-h-[48px] grid place-items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Buka Maps</a>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-10">
      <TrustBadges />
    </div>
  </section>
</BaseLayout>
