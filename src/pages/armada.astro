---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, fleet } from '../data/business';
---
<BaseLayout title={`Galeri 8 armada executive — ${business.name}`} description="Galeri armada Yossy Mandiri Jambi: Hiace Premio captain seat, Hiace Commuter, Innova Reborn, kabin hiburan TV karaoke, Fortuner. Geser untuk melihat semua unit." canonicalPath="/armada" image="/images/yossy-armada-6.jpg" breadcrumbs={[{ name: 'Armada', path: '/armada' }]}>
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Armada — 8 foto resmi</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-bold max-w-[22ch]">Geser, pilih kabin favoritmu</h1>
    <p class="mt-4 text-base text-zinc-600 max-w-[65ch]">Foto asli dari situs resmi operator (Fortuner menyusul — konfirmasi unit via WA). Geser galeri ke samping; unit di tengah tampil penuh.</p>
  </section>
  <section class="py-10 w-full">
    <div class="coverflow flex gap-5 overflow-x-auto px-[8vw] pb-4">
      {fleet.map((v, i) => (
        <figure class="shrink-0 w-72 md:w-96" tabindex="0">
          <img src={`/images/${v.img}`} alt={`${v.name} — armada PT Yossy Mandiri Travel`} width={v.w} height={v.h} loading={i < 2 ? 'eager' : 'lazy'} class="w-full h-72 md:h-96 object-cover rounded-[2rem] border border-blue-900/15" />
          <figcaption class="mt-3 px-1">
            <p class="font-mono-num text-xs text-blue-900 font-semibold">UNIT 0{i + 1}</p>
            <p class="font-semibold text-lg tracking-tight">{v.name}</p>
            <p class="mt-1 text-sm text-zinc-600">{v.desc}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="max-w-6xl mx-auto px-4 mt-2 text-xs text-zinc-400">Sumber foto: yossymandiritravel.com (situs resmi). Tips: gunakan dua jari / shift + scroll untuk menggeser.</p>
  </section>
  <section class="max-w-6xl mx-auto px-4 pb-14 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-8 bg-white border border-blue-900/15 rounded-[2rem] p-8">
        <h2 class="font-semibold text-lg tracking-tight">Fasilitas perjalanan</h2>
        <p class="mt-2 text-sm text-zinc-600">AC, jok captain seat, TV + karaoke di unit Premio, layanan via tol, antar-jemput hingga lokasi.</p>
      </div>
      <div class="md:col-span-4 bg-blue-900 text-white rounded-[2rem] p-8">
        <h2 class="font-semibold text-lg tracking-tight">Carter rombongan?</h2>
        <p class="mt-2 text-sm text-blue-100">Harga carter Hiace / Innova via loket Jambi.</p>
        <a href="/pesan" class="mt-5 inline-block bg-white text-blue-900 px-6 py-3 rounded-full text-sm font-semibold transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan kursi</a>
      </div>
    </div>
  </section>
</BaseLayout>
