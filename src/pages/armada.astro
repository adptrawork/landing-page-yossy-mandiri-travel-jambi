---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, fleet } from '../data/business';
const imgFile: Record<string, { f: string; w: number; h: number }> = { premio: { f: 'yossy-armada-6.jpg', w: 767, h: 776 }, hiace: { f: 'yossy-armada-2.jpg', w: 1074, h: 604 }, innova1: { f: 'yossy-armada-1.jpg', w: 900, h: 1200 }, innova2: { f: 'yossy-armada-3.jpg', w: 550, h: 1193 }, kabin: { f: 'yossy-armada-5.jpg', w: 1093, h: 1103 } };
---
<BaseLayout title={`Armada — ${business.name}`} description={`Armada ${business.name}: Hiace Premio, Hiace Commuter, Innova Reborn, Fortuner`} canonicalPath="/armada" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-blue-700">Armada</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Hiace, Innova, dan Fortuner siap jalan</h1>
    <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Jenis armada sesuai halaman armada situs resmi (termasuk Fortuner — fotonya menyusul, konfirmasi unit via WA). Foto di bawah adalah foto asli dari situs resmi operator.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {fleet.map((v, i) => (
        <article class:list={['reveal', i % 2 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 h-full">
            <img src={`/images/${imgFile[v.img].f}`} alt={v.name} width={imgFile[v.img].w} height={imgFile[v.img].h} loading="lazy" class="w-full h-60 object-cover rounded-3xl" />
            <h2 class="mt-4 font-semibold text-lg tracking-tight">{v.name}</h2>
            <p class="mt-1 text-base text-gray-600">{v.desc}</p>
          </div>
          <p class="mt-3 text-xs text-zinc-400 px-2">Sumber foto: situs resmi operator — ganti foto asli.</p>
        </article>
      ))}
    </div>
    <div class="mt-8 bg-zinc-950 text-white rounded-[2.5rem] p-8 md:p-10">
      <h2 class="font-semibold text-lg tracking-tight">Fasilitas perjalanan</h2>
      <p class="mt-2 text-sm text-zinc-300">AC, jok captain seat, TV + karaoke di unit Premio, layanan via tol, antar-jemput hingga lokasi.</p>
      <a href="/pesan" class="mt-5 inline-block bg-white text-zinc-950 px-6 py-3 rounded-full text-sm font-medium">Pesan kursi</a>
    </div>
  </section>
</BaseLayout>
