---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, routes } from '../data/business';
---
<BaseLayout title={`Pesan kursi executive via tol — ${business.name}`} description="Form pesan kursi Yossy Mandiri Jambi: pilih rute tol Sumatera, tanggal, jumlah kursi — terkirim rapi via WhatsApp loket." canonicalPath="/pesan" image={business.ogImage} breadcrumbs={[{ name: 'Pesan Kursi', path: '/pesan' }]}>
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Pesan Kursi</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-bold max-w-[22ch]">Isi 30 detik, kursi terkunci</h1>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <form id="book" class="md:col-span-7 reveal bg-white border border-blue-900/15 rounded-[2rem] p-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <label class="flex flex-col gap-1.5 font-medium">Nama<input required name="nama" placeholder="Nama penumpang" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-blue-900 focus:outline-none" /></label>
          <label class="flex flex-col gap-1.5 font-medium">No. WA<input required name="nowa" placeholder="08xx" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-blue-900 focus:outline-none" /></label>
          <label class="flex flex-col gap-1.5 font-medium">Rute<select required name="rute" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-blue-900 focus:outline-none">
            {routes.map((r) => (<option value={r.name}>{r.name} — {r.price}</option>))}
          </select></label>
          <label class="flex flex-col gap-1.5 font-medium">Tanggal berangkat<input required name="tanggal" type="date" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-blue-900 focus:outline-none" /></label>
          <label class="flex flex-col gap-1.5 font-medium">Jumlah kursi<input required name="jumlah" type="number" min="1" value="1" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-blue-900 focus:outline-none" /></label>
        </div>
        <p id="book-err" class="hidden mt-3 text-sm text-red-700">Lengkapi semua kolom dan pilih tanggal hari ini atau sesudahnya.</p>
        <button type="submit" class="mt-6 bg-blue-900 text-white px-7 py-3.5 rounded-full text-sm font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Kirim pesanan via WA</button>
      </form>
      <script>
        const form = document.getElementById('book') as HTMLFormElement | null;
        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(form);
          const tgl = String(fd.get('tanggal') || '');
          const today = new Date().toISOString().slice(0, 10);
          const err = document.getElementById('book-err');
          if (!fd.get('nama') || !fd.get('nowa') || !fd.get('rute') || !tgl || !fd.get('jumlah') || tgl < today) {
            err?.classList.remove('hidden');
            return;
          }
          err?.classList.add('hidden');
          const msg = `Halo PT Yossy Mandiri Travel, saya mau pesan kursi. Rute: ${fd.get('rute')}, tanggal ${tgl}, ${fd.get('jumlah')} kursi. Nama: ${fd.get('nama')}, WA: ${fd.get('nowa')}. Apakah tersedia?`;
          window.open(`https://wa.me/6282186578514?text=${encodeURIComponent(msg)}`, '_blank');
        });
      </script>
      <div class="md:col-span-5 reveal reveal-d1">
        <ol class="bg-blue-900 text-white rounded-[2rem] p-8 h-full list-none space-y-4 text-sm">
          <li class="flex gap-3"><span class="font-mono-num font-semibold text-blue-200">01</span> Isi form dengan data valid.</li>
          <li class="flex gap-3"><span class="font-mono-num font-semibold text-blue-200">02</span> Pesan terkirim rapi ke WA loket.</li>
          <li class="flex gap-3"><span class="font-mono-num font-semibold text-blue-200">03</span> Admin konfirmasi kursi + instruksi bayar.</li>
          <li class="flex gap-3"><span class="font-mono-num font-semibold text-blue-200">04</span> Simpan bukti bayar, datang tepat waktu.</li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
