---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, routes } from '../data/business';
---
<BaseLayout title={`Pesan kursi — ${business.name}`} description={`Form pesan kursi ${business.name}: pilih rute, tanggal, dan jumlah kursi, kirim rapi via WhatsApp.`} canonicalPath="/pesan" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-blue-700">Pesan Kursi</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Isi form, kursi terkirim rapi</h1>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <form id="book" class="md:col-span-7 reveal bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <label class="flex flex-col gap-1.5 font-medium">Nama<input required name="nama" placeholder="Nama penumpang" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3" /></label>
          <label class="flex flex-col gap-1.5 font-medium">No. WA<input required name="now.a" placeholder="08xx" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3" /></label>
          <label class="flex flex-col gap-1.5 font-medium">Rute<select required name="rute" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3">
            {routes.map((r) => (<option value={r.name}>{r.name} — {r.price}</option>))}
          </select></label>
          <label class="flex flex-col gap-1.5 font-medium">Tanggal berangkat<input required name="tanggal" type="date" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3" /></label>
          <label class="flex flex-col gap-1.5 font-medium">Jumlah kursi<input required name="jumlah" type="number" min="1" value="1" class="font-normal border border-zinc-300 rounded-2xl px-4 py-3" /></label>
        </div>
        <p id="book-err" class="hidden mt-3 text-sm text-red-600">Lengkapi semua kolom dan pilih tanggal hari ini atau sesudahnya.</p>
        <button type="submit" class="mt-6 bg-blue-700 text-white px-7 py-3.5 rounded-full text-sm font-medium">Kirim pesanan via WA</button>
      </form>
      <script>
        const form = document.getElementById('book') as HTMLFormElement | null;
        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(form);
          const tgl = String(fd.get('tanggal') || '');
          const today = new Date().toISOString().slice(0, 10);
          const err = document.getElementById('book-err');
          if (!fd.get('nama') || !fd.get('now.a') || !fd.get('rute') || !tgl || !fd.get('jumlah') || tgl < today) {
            err?.classList.remove('hidden');
            return;
          }
          err?.classList.add('hidden');
          const msg = `Halo ${'PT Yossy Mandiri Travel'}, saya mau pesan kursi. Rute: ${fd.get('rute')}, tanggal ${tgl}, ${fd.get('jumlah')} kursi. Nama: ${fd.get('nama')}, WA: ${fd.get('now.a')}. Apakah tersedia?`;
          window.open(`https://wa.me/${'6282186578514'}?text=${encodeURIComponent(msg)}`, '_blank');
        });
      </script>
      <div class="md:col-span-5 reveal">
        <div class="bg-zinc-950 text-white rounded-[2.5rem] p-8 md:p-10 h-full">
          <h2 class="font-semibold text-lg tracking-tight">Alur pemesanan</h2>
          <ol class="mt-4 space-y-3 text-sm text-zinc-300 list-decimal list-inside">
            <li>Isi form di samping dengan data valid.</li>
            <li>Pesan terkirim rapi ke WA admin.</li>
            <li>Admin konfirmasi kursi dan instruksi bayar.</li>
            <li>Simpan bukti bayar dan datang tepat waktu.</li>
          </ol>
          <p class="mt-5 text-xs text-zinc-500">Jangan transfer sebelum admin mengonfirmasi kursi.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
