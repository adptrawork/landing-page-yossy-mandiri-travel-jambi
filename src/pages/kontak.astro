---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, faqs, notes } from '../data/business';
---
<BaseLayout title={`Kontak & FAQ — ${business.name}`} description={`Kontak ${business.name}: ${business.address}. ${business.hours}. FAQ titik jemput, bagasi, dan refund.`} canonicalPath="/kontak" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-blue-700">Kontak</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Hubungi loket langsung</h1>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-5 reveal">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
          <h2 class="font-semibold text-lg tracking-tight">Loket</h2>
          <p class="mt-2 text-base text-gray-600">{business.address}</p>
          <p class="mt-4 text-sm text-gray-600">{business.hours}</p>
          <p class="mt-4 font-mono-num font-semibold">{business.phoneDisplay}</p>
          {business.phoneAlt && <p class='mt-1 text-xs text-zinc-500'>{business.phoneAlt}</p>}
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={business.ctaUrl} target="_blank" rel="noopener" class="bg-blue-700 text-white px-7 py-3.5 rounded-full text-sm font-medium">{business.ctaLabel}</a>
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="border border-zinc-300 px-7 py-3.5 rounded-full text-sm font-medium">Buka Maps</a>
          </div>
          {notes.map((n) => (<p class="mt-4 text-sm text-zinc-500 border-l-2 border-blue-700 pl-3">{n}</p>))}
        </div>
      </div>
      <div class="md:col-span-7 reveal">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10">
          <h2 class="font-semibold text-lg tracking-tight">Pertanyaan umum</h2>
          <div class="mt-4 divide-y divide-zinc-200">
            {faqs.map((f) => (
              <details class="py-4 group">
                <summary class="font-medium cursor-pointer list-none flex justify-between items-center gap-4">{f.q}<span class="text-blue-700 group-open:rotate-45 transition text-xl leading-none">+</span></summary>
                <p class="mt-2 text-sm text-gray-600 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
        <div class="mt-6 rounded-[2.5rem] overflow-hidden border border-slate-200/50 bg-zinc-100 h-[320px]">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
