---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, faqs, notes } from '../data/business';
---
<BaseLayout title={`Kontak loket Simpang Kawat & FAQ — ${business.name}`} description="Kontak Yossy Mandiri loket Jambi Jl. HOS Cokroaminoto Simpang Kawat: WA 0821-8657-8514. FAQ jemput lokasi, via tol, refund, carter." canonicalPath="/kontak" image={business.ogImage} breadcrumbs={[{ name: 'Kontak', path: '/kontak' }]}>
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Kontak</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-bold max-w-[22ch]">Telepon loket, bukan calo</h1>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-4 reveal">
        <div class="bg-blue-900 text-white rounded-[2rem] p-8 h-full">
          <h2 class="font-semibold text-lg tracking-tight">Loket Jambi</h2>
          <p class="mt-2 text-sm text-blue-100">{business.address}</p>
          <p class="mt-4 text-sm text-blue-100">{business.hours}</p>
          <p class="mt-4 font-mono-num font-semibold text-lg">{business.phoneDisplay}</p>
          {business.phoneAlt && <p class="mt-1 text-xs text-blue-200">{business.phoneAlt}</p>}
          <div class="mt-6 flex flex-col gap-3">
            <a href={business.ctaUrl} target="_blank" rel="noopener" class="bg-white text-blue-900 text-center px-6 py-3 rounded-full text-sm font-semibold transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">{business.ctaLabel}</a>
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="border border-white/40 text-center px-6 py-3 rounded-full text-sm font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Buka Maps</a>
          </div>
        </div>
      </div>
      <div class="md:col-span-8 reveal reveal-d1">
        <div class="bg-white border border-blue-900/15 rounded-[2rem] p-8">
          <h2 class="font-semibold text-lg tracking-tight">Pertanyaan umum</h2>
          <div class="mt-4 divide-y divide-blue-900/10">
            {faqs.map((f) => (
              <details class="py-4 group">
                <summary class="font-medium cursor-pointer list-none flex justify-between items-center gap-4">{f.q}<span class="text-blue-900 group-open:rotate-45 transition text-xl leading-none">+</span></summary>
                <p class="mt-2 text-sm text-zinc-600 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
          {notes.map((n) => (<p class="mt-4 text-sm text-zinc-500 border-l-2 border-blue-900 pl-3">{n}</p>))}
        </div>
        <div class="mt-6 rounded-[2rem] overflow-hidden border border-blue-900/15 bg-zinc-100 h-[320px]">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
