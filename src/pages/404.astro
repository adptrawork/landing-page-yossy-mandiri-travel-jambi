---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Rute tidak ditemukan | Yossy Mandiri" description="Halaman tidak ditemukan di situs Yossy Mandiri Travel Jambi." canonicalPath="/404">
  <div class="max-w-6xl mx-auto px-4 py-20">
    <p class="font-mono-num text-sm text-blue-900 font-semibold">404</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight font-bold">Rute ini tidak lewat tol</h1>
    <a href="/" class="mt-6 inline-block bg-blue-900 text-white px-7 py-3 rounded-full text-sm font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Kembali ke beranda</a>
  </div>
</BaseLayout>
