---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, routes } from '../data/business';
const badgeCls = (s: string) =>
  s.includes('Terverifikasi') ? 'bg-blue-900 text-white' : 'bg-amber-100 text-amber-800';
---
<BaseLayout title={`Jadwal & tarif executive via tol — ${business.name}`} description="Jadwal dan tarif Yossy Mandiri Jambi: Lampung–Jambi dan Palembang–Jambi Rp430rb executive via tol, rute Jambi–Jakarta, Pekanbaru, Padang." canonicalPath="/jadwal" image={business.ogImage} breadcrumbs={[{ name: 'Jadwal & Tarif', path: '/jadwal' }]}>
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-blue-900">Jadwal & Tarif</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-bold max-w-[22ch]">Tarif tol Sumatera, baris per baris</h1>
    <p class="mt-4 text-base text-zinc-600 max-w-[65ch]">Label navy berarti tarif terverifikasi dari <a class="underline underline-offset-4 text-blue-900" href="https://yossymandiritravel.com/tarif/" target="_blank" rel="noopener">halaman tarif resmi</a>. Konfirmasi kursi via WA sebelum transfer.</p>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="reveal bg-white border border-blue-900/15 rounded-[2rem] overflow-hidden">
      <div class="overflow-x-auto max-h-[70dvh] overflow-y-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead class="sticky top-0 z-10 bg-blue-900 text-white">
            <tr class="text-left">
              <th class="py-3.5 px-5 font-semibold">Rute</th><th class="py-3.5 px-5 font-semibold">Harga</th>
              <th class="py-3.5 px-5 font-semibold">Status</th><th class="py-3.5 px-5 font-semibold">Keterangan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-blue-900/10">
            {routes.map((r, i) => (
              <tr class:list={['transition hover:bg-blue-900/5', i % 2 === 1 && 'bg-slate-100/80']}>
                <td class="py-4 px-5 font-semibold">{r.name}</td>
                <td class="py-4 px-5 font-mono-num font-semibold whitespace-nowrap text-blue-900">{r.price}</td>
                <td class="py-4 px-5"><span class={`text-xs font-medium px-3 py-1.5 rounded-full whitespace-nowrap ${badgeCls(r.status)}`}>{r.status}</span></td>
                <td class="py-4 px-5 text-zinc-600">{r.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="mt-10">
      <a href="/pesan" class="inline-block bg-blue-900 text-white px-8 py-3.5 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan kursi sekarang</a>
    </div>
  </section>
</BaseLayout>
