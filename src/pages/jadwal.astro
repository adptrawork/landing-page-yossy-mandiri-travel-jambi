---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, routes } from '../data/business';
const badgeCls = (s: string) =>
  s.includes('Terverifikasi') ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';
---
<BaseLayout title={`Jadwal & tarif — ${business.name}`} description={`Jadwal keberangkatan dan tarif ${business.name}: rute, jam, dan harga tiket terverifikasi situs resmi.`} canonicalPath="/jadwal" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7 reveal">
        <p class="text-sm font-medium text-blue-700">Jadwal & Tarif</p>
        <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold">Rute, jam, dan harga tiket</h1>
        <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Label hijau berarti tarif terverifikasi dari situs resmi (<a class="underline underline-offset-4 text-zinc-900" href="https://yossymandiritravel.com/tarif/" target="_blank" rel="noopener">halaman tarif resmi</a>). Selalu konfirmasi kursi via WA sebelum transfer.</p>
      </div>
      <div class="md:col-span-5 reveal">
        <img src="/images/yossy-armada-7.jpg" alt="Hiace Premio silver terparkir di depan loket PT Yossy Mandiri Travel" width="648" height="864" loading="lazy" class="w-full h-56 object-cover rounded-[2.5rem] border border-slate-200/50" />
        <p class="mt-3 text-xs text-zinc-400">Sumber: yossymandiritravel.com (situs resmi) — ganti foto asli</p>
      </div>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="reveal bg-white border border-slate-200/50 rounded-[2.5rem] p-4 md:p-8 overflow-x-auto">
      <table class="w-full text-sm min-w-[640px]">
        <thead><tr class="text-left text-zinc-500 border-b border-zinc-200">
          <th class="py-3 px-4 font-medium">Rute</th><th class="py-3 px-4 font-medium">Harga</th>
          <th class="py-3 px-4 font-medium">Status</th><th class="py-3 px-4 font-medium">Keterangan</th>
        </tr></thead>
        <tbody class="divide-y divide-zinc-100">
          {routes.map((r) => (
            <tr class="hover:bg-zinc-50/70">
              <td class="py-4 px-4 font-semibold">{r.name}</td>
              <td class="py-4 px-4 font-mono-num font-semibold whitespace-nowrap">{r.price}</td>
              <td class="py-4 px-4"><span class={`text-xs font-medium px-3 py-1.5 rounded-full ${badgeCls(r.status)}`}>{r.status}</span></td>
              <td class="py-4 px-4 text-gray-600">{r.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-10 md:pl-[12vw]">
      <a href="/pesan" class="inline-block bg-blue-700 text-white px-8 py-3.5 rounded-full font-medium">Pesan kursi sekarang</a>
    </div>
  </section>
</BaseLayout>
