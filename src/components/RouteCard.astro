---
interface Route { name: string; price: string; status: string; desc: string }
interface Props { r: Route; jam: string; wa: string; index: number }
const { r, jam, wa, index } = Astro.props;
const verified = r.status.includes('Terverifikasi');
---
<!-- Ref: Shakuro Umrah&Hajj tour — booking flow jelas + paket cards + trust badges -->
<article class="bg-white border border-blue-900/15 rounded-[1.5rem] p-6 flex flex-col gap-3 transition duration-300 hover:-translate-y-1 hover:border-blue-900/40 hover:shadow-lg hover:shadow-blue-900/10">
  <div class="flex items-center justify-between gap-3">
    <span class="font-mono-num text-xs font-semibold text-blue-900">RUTE 0{index + 1}</span>
    <span class={`text-xs font-medium px-3 py-1 rounded-full whitespace-nowrap ${verified ? 'bg-blue-900 text-white' : 'bg-amber-100 text-amber-800'}`}>{r.status}</span>
  </div>
  <h3 class="font-bold text-lg tracking-tight">{r.name}</h3>
  <dl class="text-sm space-y-1.5">
    <div class="flex justify-between gap-3"><dt class="text-zinc-500">Jam</dt><dd class="font-mono-num font-semibold text-right">{jam}</dd></div>
    <div class="flex justify-between gap-3"><dt class="text-zinc-500">Harga</dt><dd class="font-mono-num font-semibold text-blue-900 text-right">{r.price}</dd></div>
  </dl>
  <p class="text-sm text-zinc-600">{r.desc}</p>
  <a href={wa} target="_blank" rel="noopener" class="mt-auto text-center bg-blue-900 text-white px-6 py-3 rounded-full text-sm font-semibold min-h-[48px] grid place-items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan {r.name.split('–')[0].trim()}</a>
</article>
